{
  "name": "ems-qa-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EMS QA: Cypress primary, Playwright API/mobile companion",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run format:check && npm run syntaxcheck && npm run test:unit && npm run coverage:catalog",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,html,css}\"",
    "syntaxcheck": "node scripts/syntax.mjs",
    "test:unit": "node --test checks/settings.test.cjs checks/demo.test.mjs checks/reporting.test.mjs checks/downloads.test.cjs checks/schedule-time.test.mjs checks/test-data-time.test.mjs",
    "test": "npm run test:demo",
    "test:demo": "node scripts/run.mjs demo all",
    "demo:serve": "node demo/server.mjs",
    "cy:open": "node scripts/run.mjs configured cypress-open",
    "cy:run": "node scripts/run.mjs configured cypress",
    "pw:run": "node scripts/run.mjs configured playwright",
    "pw:ui": "node scripts/run.mjs configured playwright-ui",
    "pw:report": "playwright show-report reports/playwright-html",
    "test:staging": "node scripts/run.mjs staging all",
    "coverage:catalog": "node scripts/catalog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "cypress": "16.1.1",
    "dotenv": "17.2.3",
    "prettier": "3.9.10"
  }
}
