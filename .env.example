# Demo berjalan lokal; ubah menjadi staging setelah kontrak aplikasi dikonfigurasi.
QA_TARGET=demo
QA_BASE_URL=
QA_API_BASE_URL=
QA_BUILD_ID=
# Staging: admin,pj,komandan. Demo tetap memakai admin,pj,user. Default staging: admin.
QA_ROLES=admin
QA_ADMIN_ID=
QA_ADMIN_PASSWORD=
QA_PJ_ID=
QA_PJ_PASSWORD=
QA_KOMANDAN_ID=
QA_KOMANDAN_PASSWORD=
# Alias _USERNAME/_EMAIL didukung. Role user dipertahankan untuk kompatibilitas.
QA_USER_ID=
QA_USER_PASSWORD=
# Cypress staging: Chrome terpasang. Demo: Electron untuk verifikasi lokal.
QA_CYPRESS_BROWSER=chrome
# Playwright memakai Chromium bawaan; isi chrome jika ingin Chrome terpasang.
QA_PLAYWRIGHT_CHANNEL=
# Opt-in TS-004: hanya untuk run Cypress yang sengaja mengunci akun target.
QA_RUN_RATE_LIMIT=0
